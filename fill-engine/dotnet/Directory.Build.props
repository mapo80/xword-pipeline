<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Native engine built by cargo (fill-engine/target/<profile>) -->
    <!-- -p:XfillRustTarget=<triple> uses target/<triple>/release (cross builds in CI) -->
    <XfillCargoTarget Condition="'$(XfillCargoTarget)' == '' and '$(XfillRustTarget)' != ''">$(MSBuildThisFileDirectory)../target/$(XfillRustTarget)/release</XfillCargoTarget>
    <XfillCargoTarget Condition="'$(XfillCargoTarget)' == ''">$(MSBuildThisFileDirectory)../target/release</XfillCargoTarget>
    <XfillNativeName Condition="'$(XfillNativeName)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">xfill.dll</XfillNativeName>
    <XfillNativeName Condition="'$(XfillNativeName)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">libxfill.dylib</XfillNativeName>
    <XfillNativeName Condition="'$(XfillNativeName)' == ''">libxfill.so</XfillNativeName>
    <!-- the process that runs the library (fill-engine/host/build.sh puts it next to it) -->
    <XfillHostName Condition="'$(XfillHostName)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">xfill-host.exe</XfillHostName>
    <XfillHostName Condition="'$(XfillHostName)' == ''">xfill-host</XfillHostName>
  </PropertyGroup>
</Project>
